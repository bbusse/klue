#!/usr/bin/env bash

set -euo pipefail

export CONTAINER="ghcr.io/bbusse/klue:latest"
#CONTAINER="${CONTAINER:-klue}"
readonly CONTAINER
export VERBOSE=1
readonly VERBOSE
export CONTAINER_PLATFORM="${CONTAINER_PLATFORM:-}"
readonly CONTAINER_PLATFORM
export CONFIG_PATH="klue.toml"
export AWS_PROFILE="production"
readonly AWS_PROFILE
export AWS_REGION="eu-central-1"
readonly AWS_REGION
CONTAINER_HOME="/home/klue"
readonly CONTAINER_HOME
STREAM_PORT=6442
readonly STREAM_PORT
STREAM=true
readonly STREAM
HOST_KUBECONFIG="${KUBECONFIG:-}"
readonly HOST_KUBECONFIG
SCRIPT_NAME=$(basename "$0")
readonly SCRIPT_NAME

if [[ $# -gt 0 ]]; then
    CONFIG_PATH="$1"
fi
readonly CONFIG_PATH

log() {
    if ((1 == "${VERBOSE}")); then
        echo "$@" >&2
    fi

    logger -p user.notice -t "${SCRIPT_NAME}" "$@"
}

error() {
    echo "$@" >&2
    logger -p user.error -t "${SCRIPT_NAME}" "$@"
}

if [[ -z $(command -v podman) ]]; then
    if [[ -z $(command -v docker) ]]; then
        error "Could not find container executor."
        error "Install either podman or docker"
        exit 1
    else
        executor=docker
        log "Using ${executor} to run ${CONTAINER}"
    fi
else
    executor=podman
    log "Using ${executor} to run ${CONTAINER}"
fi

if [[ ! -f "${CONFIG_PATH}" ]]; then
    error "Config file not found: ${CONFIG_PATH}"
    exit 1
fi

if [[ -z "${DD_API_KEY:-}" ]]; then
    error "DD_API_KEY is not set"
    exit 1
fi

if [[ -z "${DD_APP_KEY:-}" ]]; then
    error "DD_APP_KEY is not set"
    exit 1
fi

# klue is a single-instance personal dashboard: if a container from this
# image is already running, starting a second one would fail outright
# anyway (fixed STREAM_PORT publish -> "proxy already running"). Re-attach
# to it instead of erroring.
EXISTING_CONTAINER_ID=$("${executor}" ps --filter "ancestor=${CONTAINER}" --filter "status=running" --format '{{.ID}}' | head -1)
readonly EXISTING_CONTAINER_ID

MOUNT_CONFIG_PATH="${CONFIG_PATH}"
TEMP_CONFIG_COPY=""
TEMP_AWS_CACHE_DIR=""

# Podman on macOS can only mount paths shared with the Podman VM (HOME is shared by default).
# If user passes a config from an unshared path (e.g. /usr/local/src), stage a read-only copy under HOME.
# Not needed when re-attaching: the existing container already has its own
# config mounted from whenever it was started.
if [[ -z "${EXISTING_CONTAINER_ID}" && "${executor}" == "podman" && "${CONFIG_PATH}" != "${HOME}"/* ]]; then
    TEMP_CONFIG_COPY="${HOME}/.klue-config.$(date +%s).$$.toml"
    cp "${CONFIG_PATH}" "${TEMP_CONFIG_COPY}"
    MOUNT_CONFIG_PATH="${TEMP_CONFIG_COPY}"
    log "Staged config for podman mount: ${MOUNT_CONFIG_PATH}"
fi

CONTAINER_LOG=""
LOGS_PID=""
CONTAINER_ID_LIVE=""

cleanup() {
    kill "${LOGS_PID:-}" 2>/dev/null || true
    if [[ -n "${TEMP_CONFIG_COPY}" && -f "${TEMP_CONFIG_COPY}" ]]; then
        rm -f "${TEMP_CONFIG_COPY}"
    fi
    if [[ -n "${TEMP_AWS_CACHE_DIR}" && -d "${TEMP_AWS_CACHE_DIR}" ]]; then
        rm -rf "${TEMP_AWS_CACHE_DIR}"
    fi
    if [[ -n "${CONTAINER_ID_LIVE}" ]]; then
        local cstatus cexit
        cstatus=$("${executor}" inspect "${CONTAINER_ID_LIVE}" \
            --format '{{.State.Status}}' 2>/dev/null || printf "gone")
        cexit=$("${executor}" inspect "${CONTAINER_ID_LIVE}" \
            --format '{{.State.ExitCode}}' 2>/dev/null || printf "?")
        if [[ "$cstatus" != "running" ]]; then
            log "Container exited: status=${cstatus} exitCode=${cexit}"
            if [[ "$cexit" == "137" ]]; then
                log "Exit 137 = SIGKILL (OOM or external kill)"
            fi
            log "Last logs:"
            "${executor}" logs --tail 40 "${CONTAINER_ID_LIVE}" 2>&1 >&2 || true
            "${executor}" rm -f "${CONTAINER_ID_LIVE}" >/dev/null 2>&1 || true
        fi
    fi
}
trap cleanup EXIT

container_term="${TERM:-xterm-256color}"
if ! "${executor}" run --rm --entrypoint sh "${CONTAINER}" -lc "infocmp '${container_term}' >/dev/null 2>&1"; then
    log "Terminal '${container_term}' not available in container terminfo, falling back to xterm-256color"
    container_term="xterm-256color"
fi

if [[ -n "${EXISTING_CONTAINER_ID}" ]]; then
    container_id="${EXISTING_CONTAINER_ID}"
    CONTAINER_ID_LIVE="$container_id"
    log "Found running container: ${container_id:0:12}, re-attaching instead of starting a new one"
    if [[ "${STREAM}" == "true" ]]; then
        log "Stream:    http://localhost:${STREAM_PORT}/        (open in a browser)"
        log "           http://localhost:${STREAM_PORT}/stream (mpv/ffmpeg/curl — raw MJPEG feed)"
    fi
else
    CONTAINER_KUBECONFIG=""
    if [[ -n "${HOST_KUBECONFIG}" ]]; then
        IFS=':' read -r -a kubeconfig_parts <<<"${HOST_KUBECONFIG}"
        for kubeconfig_part in "${kubeconfig_parts[@]}"; do
            mapped_part="${kubeconfig_part}"
            if [[ "${kubeconfig_part}" == "${HOME}"/* ]]; then
                mapped_part="${CONTAINER_HOME}/${kubeconfig_part#"${HOME}/"}"
            fi

            if [[ -z "${CONTAINER_KUBECONFIG}" ]]; then
                CONTAINER_KUBECONFIG="${mapped_part}"
            else
                CONTAINER_KUBECONFIG="${CONTAINER_KUBECONFIG}:${mapped_part}"
            fi
        done
    fi

    args=(
        run
        -e "AWS_PROFILE=${AWS_PROFILE}"
        -e "AWS_REGION=${AWS_REGION}"
        -e DD_API_KEY
        -e DD_APP_KEY
        -v "${MOUNT_CONFIG_PATH}:/config.toml:ro"
        -v "${HOME}/.kube:${CONTAINER_HOME}/.kube:ro"
        -v "${HOME}/.aws:${CONTAINER_HOME}/.aws:ro"
    )

    TEMP_AWS_CACHE_DIR="${HOME}/.klue-aws-cache.$(date +%s).$$"
    mkdir -p "${TEMP_AWS_CACHE_DIR}"
    args+=(-v "${TEMP_AWS_CACHE_DIR}:${CONTAINER_HOME}/.aws/cli/cache:rw")

    args+=(-e "TERM=${container_term}")

    for passthrough_var in COLORTERM LANG LC_ALL LC_CTYPE; do
        if [[ -n "${!passthrough_var:-}" ]]; then
            args+=(-e "${passthrough_var}=${!passthrough_var}")
        fi
    done

    if [[ -n "${CONTAINER_KUBECONFIG}" ]]; then
        args+=(-e "KUBECONFIG=${CONTAINER_KUBECONFIG}")
    fi

    if [[ -n "${CONTAINER_PLATFORM}" ]]; then
        args+=(--platform "${CONTAINER_PLATFORM}")
    fi

    if [[ -d "${HOME}/.aws/sso" ]]; then
        args+=(-v "${HOME}/.aws/sso:${CONTAINER_HOME}/.aws/sso:ro")
    fi

    # Always run detached so the container persists after detach.
    # No --rm: we do explicit cleanup in cleanup() with post-mortem logging.
    args+=(-d)

    if [[ "${STREAM}" == "true" ]]; then
        args+=(-p "${STREAM_PORT}:${STREAM_PORT}")
    fi

    args+=(
        --entrypoint /usr/local/bin/klue
        "${CONTAINER}"
        --config /config.toml
    )

    if [[ "${STREAM}" == "true" ]]; then
        args+=(--stream --stream-port "${STREAM_PORT}"
            --stream-font "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf")
    fi

    container_id=$("${executor}" "${args[@]}")
    CONTAINER_ID_LIVE="$container_id"
    log "Container: ${container_id:0:12}"
    if [[ "${STREAM}" == "true" ]]; then
        log "Stream:    http://localhost:${STREAM_PORT}/        (open in a browser)"
        log "           http://localhost:${STREAM_PORT}/stream (mpv/ffmpeg/curl — raw MJPEG feed)"
    fi
    log "Stop:      ${executor} rm -f ${container_id:0:12}"
fi

# Follow container logs to a temp file so they survive --rm.
CONTAINER_LOG="${HOME}/.klue-container-${container_id:0:12}.log"
"${executor}" logs -f "$container_id" >"$CONTAINER_LOG" 2>&1 &
LOGS_PID=$!
disown "$LOGS_PID" 2>/dev/null || true
log "Logs:      tail -f ${CONTAINER_LOG}"

# Wait for the tmux session to be ready inside the container
deadline=$((SECONDS + 30))
while ((SECONDS < deadline)); do
    if "${executor}" exec "${container_id}" tmux list-sessions >/dev/null 2>&1; then
        break
    fi
    # Check if the container has already died
    if ! "${executor}" inspect "$container_id" >/dev/null 2>&1; then
        error "Container died before session was ready. Check logs: ${CONTAINER_LOG}"
        exit 1
    fi
    sleep 0.3
done

log "Attaching to dashboard (detach: Ctrl+B d)"
"${executor}" exec -it -e "TERM=${container_term}" "${container_id}" tmux attach-session || true

# After detach: report container status so the user knows what happened
cstatus=$("${executor}" inspect "$container_id" \
    --format '{{.State.Status}}' 2>/dev/null || printf "gone")
log "Container status after detach: ${cstatus} (id: ${container_id:0:12})"
if [[ "$cstatus" == "running" ]]; then
    log "Re-attach: ${executor} exec -it ${container_id:0:12} tmux attach-session"
elif [[ "$cstatus" == "gone" ]]; then
    log "Container was already removed (--rm or podman restart policy)"
else
    cexit=$("${executor}" inspect "$container_id" \
        --format '{{.State.ExitCode}}' 2>/dev/null || printf "?")
    log "Container exited (exitCode=${cexit}). Logs:"
    "${executor}" logs --tail 40 "$container_id" 2>&1 >&2 || true
    "${executor}" rm -f "$container_id" >/dev/null 2>&1 || true
fi
